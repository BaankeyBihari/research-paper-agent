OPENROUTER_API_KEY=sk-or-v1-your-key-here
ACTIVE_MODEL_SLUG=nvidia/nemotron-3-nano-30b-a3b

# Used by simulator.py (what gets downloaded) and agent.py (what gets processed).
# ARXIV_PAPER_IDS: comma-separated arXiv IDs (versioned or not) to fetch/process
# specifically, instead of random recent papers / everything on disk.
# NUM_PAPERS: fetch/process up to this many (an upper bound, not a guarantee -- simulator.py
# skips feed entries that already exist on disk or have no PDF link, and agent.py may simply
# have fewer than N pending PDFs). Takes precedence over ARXIV_PAPER_IDS entirely when both
# are set -- simulator.py falls back to N random papers and agent.py falls back to the first
# N pending papers, ignoring the ID list.
# ARXIV_PAPER_IDS=2608.11597,2608.11590
# NUM_PAPERS=3

# Used only by compare_models.py (docker compose exec research-agent python compare_models.py).
# REFERENCE_MODEL_SLUG is paid. Same COMPARE_ARXIV_PAPER_IDS / COMPARE_NUM_PAPERS precedence
# as above, scoped separately so you can compare a different paper set than you process.
# meta-llama/llama-3.1-70b-instruct (an earlier default here) reliably fails to return
# structured output under NOOA's tool-calling strategy -- verified live, not paper-specific.
# REFERENCE_MODEL_SLUG=openai/gpt-4o-mini
# CANDIDATE_MODEL_SLUGS=nvidia/nemotron-3-nano-30b-a3b,nvidia/nemotron-3.5-lightning
# COMPARE_ARXIV_PAPER_IDS=2608.11597,2608.11590
# COMPARE_NUM_PAPERS=2
